# Copy this file to .env.local (preferred, gitignored) or .env and fill in
# your values. The server loads it automatically from the project root at
# startup; environment variables passed by the MCP client take precedence.

# Your Worksection account URL (e.g. https://mycompany.worksection.com)
WORKSECTION_URL=https://yourcompany.worksection.com

# Admin API key (Administration → API → Apps, or legacy Account → API)
# Only the account owner can access this key
WORKSECTION_API_KEY=your_api_key_here

# Optional: default author email for created tasks/projects/comments.
# Without it, actions are attributed to the API key owner.
# WORKSECTION_DEFAULT_USER_EMAIL=you@yourcompany.com
